[{"id": "content", "sections": [{"id": "56805f2c23dd412ab8f7a3da0158ffe5", "name": "Rich text", "type": "RICH_TEXT", "hidden": false, "deferred": false, "required": false, "settings": [{"name": "heading", "value": "", "translationKey": null, "mailSettingsKey": null}, {"name": "text", "value": "<p><br></p>\n<p><span style=\"color: #FFFFFF; font-size: 36px; font-family: Garamond, serif\"><strong>How did nature's</strong></span></p>\n<p><span style=\"color: #FFFFFF; font-size: 36px; font-family: Garamond, serif\"><strong>colors treat you</strong></span><span style=\"color: #FFFFFF; font-size: 30px; font-family: Garamond, serif\"><strong>?</strong></span></p>\n<p><br></p>\n<p><span style=\"color: #D4EDE4; background-color: #2D4A3F; font-size: 16px; font-family: Georgia, serif; letter-spacing: normal\">We spent over a year crafting these natural shades.</span><br>\n<span style=\"color: #D4EDE4; background-color: #2D4A3F; font-size: 16px; font-family: Georgia, serif; letter-spacing: normal\">Now we want to see what you did with them.</span></p>", "translationKey": null, "mailSettingsKey": null}, {"name": "textAlignment", "value": "center", "translationKey": null, "mailSettingsKey": null}, {"name": "backgroundColor", "value": "#2d4a3f", "translationKey": null, "mailSettingsKey": null}, {"name": "hidePadding", "value": true, "translationKey": null, "mailSettingsKey": null}, {"name": "textColor", "value": "#d4ede4", "translationKey": null, "mailSettingsKey": null}, {"name": "headingColor", "value": "#ffffff", "translationKey": null, "mailSettingsKey": null}]}, {"id": "ff3fc8ee6a694275a19ff01a2ad5ae12", "name": "Image", "type": "IMAGE", "hidden": true, "deferred": false, "required": false, "settings": [{"name": "imageUrl", "value": "https://cdn.seguno.com/a4c4ea9c153645f28b81128ede5065b8/images/canva_723aabb6bc59aa57c1ce7ec82de5d4e1-1775837518679.png", "translationKey": null, "mailSettingsKey": null}, {"name": "linkUrl", "value": "https://www.thesugarart.com", "translationKey": null, "mailSettingsKey": null}, {"name": "imageWidth", "value": null, "translationKey": null, "mailSettingsKey": null}, {"name": "altText", "value": "Swatches", "translationKey": null, "mailSettingsKey": null}, {"name": "imageCanvaId", "value": null, "translationKey": null, "mailSettingsKey": null}, {"name": "backgroundColor", "value": "#2d4a3f", "translationKey": null, "mailSettingsKey": null}]}, {"id": "574f45fdfb4d4ddfab3b7ee68f6997ad", "name": "Rich text", "type": "RICH_TEXT", "hidden": false, "deferred": false, "required": false, "settings": [{"name": "heading", "value": "", "translationKey": null, "mailSettingsKey": null}, {"name": "text", "value": "<p><br></p>\n<p><span style=\"font-size: 20px; line-height: 1.3em\">Hi </span>{{ customer.first_name | default: 'there' }}<span style=\"font-size: 20px; line-height: 1.3em\">,</span></p>\n<p><br></p>\n<p><span style=\"line-height: 1.3em\">Thank you so much for being one of the first to try our new Natural Colors line. We hope they've arrived safely and that you've had a chance to put them to work in your kitchen.</span></p>\n<p><br></p>\n<p><span style=\"line-height: 1.3em\">Natural pigments behave differently than anything else we've made - they're alive in ways that synthetic colors just aren't. So we're genuinely curious: how did they perform for you?</span></p>", "translationKey": null, "mailSettingsKey": null}, {"name": "textAlignment", "value": "left", "translationKey": null, "mailSettingsKey": null}, {"name": "backgroundColor", "value": "#ffffff", "translationKey": null, "mailSettingsKey": null}, {"name": "hidePadding", "value": true, "translationKey": null, "mailSettingsKey": null}]}, {"id": "ffbdd127a5b444bda0bd3203fa14c3cd", "name": "Rich text", "type": "RICH_TEXT", "hidden": false, "deferred": false, "required": false, "settings": [{"name": "heading", "value": "", "translationKey": null, "mailSettingsKey": null}, {"name": "text", "value": "<p style=\"text-align: start\"><span style=\"color: #5AAC88; letter-spacing: 1px; line-height: 1.6em\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;→</span><span style=\"letter-spacing: 1px; line-height: 1.6em\">&nbsp;Which shade surprised you the most?</span></p>\n<p style=\"text-align: start\"><span style=\"color: #5AAC88; letter-spacing: 1px; line-height: 1.6em\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;→</span><span style=\"letter-spacing: 1px; line-height: 1.6em\">&nbsp;How did they hold up in your buttercream or royal icing?</span></p>\n<p style=\"text-align: start\"><span style=\"color: #5AAC88; letter-spacing: 1px; line-height: 1.6em\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;→</span><span style=\"letter-spacing: 1px; line-height: 1.6em\">&nbsp;Any questions we can help answer?&nbsp;</span></p>", "translationKey": null, "mailSettingsKey": null}, {"name": "textAlignment", "value": "left", "translationKey": null, "mailSettingsKey": null}, {"name": "backgroundColor", "value": "#c2f1e2", "translationKey": null, "mailSettingsKey": null}, {"name": "hidePadding", "value": false, "translationKey": null, "mailSettingsKey": null}]}, {"id": "87d48d109ab24b3ab01303832c0a0f23", "name": "Rich text", "type": "RICH_TEXT", "hidden": false, "deferred": false, "required": false, "settings": [{"name": "heading", "value": "", "translationKey": null, "mailSettingsKey": null}, {"name": "text", "value": "<p><br></p>\n<p><span style=\"line-height: 1.3em\">Just hit reply, we read every single one. And if you have a photo of something you made with these colors, please send it our way! There's nothing we love more than seeing our colors in the hands of talented artists like you.</span></p>", "translationKey": null, "mailSettingsKey": null}, {"name": "textAlignment", "value": "left", "translationKey": null, "mailSettingsKey": null}, {"name": "backgroundColor", "value": "#ffffff", "translationKey": null, "mailSettingsKey": null}, {"name": "hidePadding", "value": true, "translationKey": null, "mailSettingsKey": null}]}, {"id": "c0a31cf57e6d4f1ba1f05b403927242d", "name": "Button group", "type": "BUTTON_GROUP", "hidden": false, "deferred": false, "required": false, "settings": [{"name": "buttonStyle", "value": "SOLID", "translationKey": null, "mailSettingsKey": null}, {"name": "textSize", "value": "medium", "translationKey": null, "mailSettingsKey": null}, {"name": "hidePadding", "value": true, "translationKey": null, "mailSettingsKey": null}, {"name": "boldText", "value": false, "translationKey": null, "mailSettingsKey": null}, {"name": "buttons", "value": [{"id": "ba5e3ea8-702f-4fe5-ba40-b91827cefad8", "buttonUrl": "mailto:hello@thesugarart.com", "buttonText": "Reply & share your experience"}], "translationKey": null, "mailSettingsKey": null}, {"name": "buttonBackgroundColor", "value": "#303030", "translationKey": null, "mailSettingsKey": null}, {"name": "buttonTextColor", "value": "#ffffff", "translationKey": null, "mailSettingsKey": null}, {"name": "backgroundColor", "value": "#ffffff", "translationKey": null, "mailSettingsKey": null}]}, {"id": "3ae599ddffb9442ab0dcc2fd09953802", "name": "Spacer", "type": "SPACER", "hidden": false, "deferred": false, "required": false, "settings": [{"name": "size", "value": "small", "translationKey": null, "mailSettingsKey": null}, {"name": "backgroundColor", "value": "#ffffff", "translationKey": null, "mailSettingsKey": null}]}, {"id": "5d31f014df82441ebf63f79c1c74c65b", "name": "Rich text", "type": "RICH_TEXT", "hidden": false, "deferred": false, "required": false, "settings": [{"name": "heading", "value": "", "translationKey": null, "mailSettingsKey": null}, {"name": "text", "value": "<p><br></p>\n<p><span style=\"font-size: 24px\">🌿 Show us your creation</span></p>\n<p><br></p>\n<p>Your feedback genuinely shapes where we take this line next. We have more colors in development, and early input from artists like you helps us get them right.</p>", "translationKey": null, "mailSettingsKey": null}, {"name": "textAlignment", "value": "center", "translationKey": null, "mailSettingsKey": null}, {"name": "backgroun